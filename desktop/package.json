{
  "name": "gul-desktop",
  "version": "0.8.0-alpha.0",
  "private": true,
  "description": "Gul voice and screen sharing",
  "author": "Gul contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "format": "prettier --write src test e2e scripts package.json tsconfig.json playwright.config.ts .prettierrc.json",
    "format:check": "prettier --check src test e2e scripts package.json tsconfig.json playwright.config.ts .prettierrc.json",
    "test:integration": "playwright test --config playwright.config.ts",
    "vendor:xray": "node scripts/vendor-xray.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@livekit/protocol": "1.50.4",
    "livekit-client": "2.22.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.2",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "typescript": "6.0.2"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "build": {
    "appId": "io.github.lywwkkaad.gul.electron",
    "productName": "Gul",
    "directories": {
      "output": "artifacts"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "resources/xray",
        "to": "xray",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "dist/licenses",
        "to": "THIRD_PARTY_LICENSES"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "../build/darwin/icons.icns",
      "category": "public.app-category.social-networking",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Gul использует микрофон для голосового общения.",
        "NSAudioCaptureUsageDescription": "Gul передаёт звук выбранной демонстрации."
      }
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "../build/windows/icon.ico"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "../build/appicon.png",
      "category": "Network",
      "maintainer": "Gul contributors",
      "desktop": {
        "entry": {
          "StartupWMClass": "Gul"
        }
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  }
}
