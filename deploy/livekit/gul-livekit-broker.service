[Unit]
Description=Gul authenticated LiveKit broker
After=network-online.target docker.service gul-livekit-firewall.service
Requires=gul-livekit-firewall.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=gul-livekit
StateDirectoryMode=0700
LoadCredential=config.json:/opt/gul-livekit/private/broker.json
ExecStart=/usr/local/libexec/gul-livekit-server -config ${CREDENTIALS_DIRECTORY}/config.json
Restart=on-failure
RestartSec=2s
MemoryMax=128M
Environment=GOMEMLIMIT=96MiB
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
