# Local integration fixture only; never use this image for production.
FROM debian:12-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    haproxy openssl curl python3 ca-certificates && rm -rf /var/lib/apt/lists/*
CMD ["sleep", "infinity"]
