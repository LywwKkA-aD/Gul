FROM scratch

LABEL org.opencontainers.image.title="Gul Xray REALITY endpoint" \
      org.opencontainers.image.source="https://github.com/XTLS/Xray-core" \
      org.opencontainers.image.version="26.3.27" \
      org.opencontainers.image.licenses="MPL-2.0"

COPY xray /usr/local/bin/xray
COPY LICENSE /usr/share/licenses/xray/LICENSE

USER 10000:10000
ENTRYPOINT ["/usr/local/bin/xray"]
CMD ["run", "-config", "/etc/xray/server.json"]
